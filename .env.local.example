# Sanity CMS configuration
# Copy this file to .env.local and fill in the real values after
# creating your Sanity project. Never commit .env.local.

# Found at https://www.sanity.io/manage once you've created the project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# Usually 'production'. Change if you set up staging/dev datasets.
NEXT_PUBLIC_SANITY_DATASET=production

# Pin to a date that predates when you need new API features.
# See https://www.sanity.io/docs/api-versioning
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: server-side read token for private/draft content.
# Create under Project settings > API > Tokens (Viewer role).
# Only required if you use draft previews.
SANITY_API_READ_TOKEN=

# Required for the /api/revalidate webhook.
# Generate a random string. Paste the same value into the
# Sanity webhook under "Secret".
SANITY_REVALIDATE_SECRET=

# HubSpot newsletter signup
# Used by /api/newsletter so the email entered on content pages is
# pushed straight into HubSpot.
# Find the Hub ID at the top right of any HubSpot screen, or under
# Settings > Account Setup > Account Defaults > Account Information.
HUBSPOT_PORTAL_ID=

# Form GUID. Create a form in HubSpot under
# Marketing > Forms > Create form > Embedded form. Add an Email field
# (and any optional fields). Save. The GUID appears in the form's URL
# and in the embed snippet HubSpot generates.
HUBSPOT_FORM_ID=

# Region prefix. "na1" (default) for US accounts, "eu1" for EU.
# Match the prefix in your HubSpot URL, e.g. app-eu1.hubspot.com.
HUBSPOT_REGION=na1
